<?xml version="1.0"?>
<ruleset name="u2auth-php-sdk">
  <description>Enforces the PHP 7.4 floor. The test suite cannot: it runs on 8.x.</description>

  <file>src</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg value="ps"/>

  <!-- The whole point of this ruleset. Anything newer than 7.4 is an error,
       because WordPress's floor is 7.2.24 and a large share of live installs
       run 7.4, the audience this SDK exists to reach. -->
  <config name="testVersion" value="7.4-"/>
  <rule ref="PHPCompatibility"/>
</ruleset>
