{
  "name": "u2secured/u2auth",
  "description": "U2 Secured Authenticator SDK - push tap-to-approve two-factor auth, TOTP, and signed webhooks.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-hash": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.9",
    "phpcompatibility/php-compatibility": "^9.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "U2Secured\\U2Auth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "U2Secured\\U2Auth\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4"
    }
  },
  "scripts": {
    "lint": [
      "phpcs",
      "bash bin/check-php74-syntax.sh"
    ],
    "lint:php74": "bash bin/check-php74-syntax.sh",
    "test": "phpunit"
  }
}
